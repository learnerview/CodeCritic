# Example environment variables (DO NOT commit real keys)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
JAVA_SERVER_URL=http://localhost:8080/api
GITHUB_TOKEN=
CORS_ALLOW_ORIGINS=*
AUTH_USERNAME=admin
AUTH_PASSWORD=admin
JWT_SECRET=codecritic-demo-secret-key-change-me-in-production-0123456789
JWT_EXPIRATION_MS=86400000
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
MAX_REQUEST_BYTES=1500000
# Redis is configured from REDIS_URL (e.g. Upstash on Render).
# Formats: redis://host:port, redis://user:pass@host:port, rediss://user:pass@host:port (TLS).
# Leave unset for local development (falls back to redis://localhost:6379).
REDIS_URL=
# Dashboard-only: tells the Java service where the Python agent lives
# (differs between localhost and Render). Leave unset for local development.
PYTHON_AGENT_URL=
# SimplyDone4J knobs (defaults apply if unset):
SIMPLYDONE4J_ENABLED=true
SIMPLYDONE4J_SCHEDULER_ENABLED=true
SIMPLYDONE4J_MONITORING_ENABLED=true
SIMPLYDONE4J_EXECUTOR_CORE_POOL_SIZE=2
SIMPLYDONE4J_EXECUTOR_MAX_POOL_SIZE=4
SIMPLYDONE4J_EXECUTOR_QUEUE_CAPACITY=50
SIMPLYDONE4J_QUEUE_MAX_DEPTH=5000